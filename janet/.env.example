# ---- Required for a phone-call MVP ----
DATABASE_URL=                     # Supabase Postgres (Settings > Database > Session pooler or direct, port 5432)
PUBLIC_BASE_URL=                  # https URL where this server is reachable, e.g. https://janet.onrender.com
JANET_OWNER_PHONE=                # your cell, E.164: +1561...  Only this number can talk to JANET.
JANET_OWNER_NAME=Kyle
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=              # JANET's dedicated number, E.164
OPENAI_API_KEY=
JANET_ADMIN_PASSWORD=             # dashboard password, 12+ characters
JANET_SESSION_SECRET=             # random, 32+ characters:  openssl rand -base64 48

# ---- Recommended ----
JANET_CALLER_PIN=                 # keypad PIN asked on inbound calls (caller ID can be spoofed). Blank = number check only.
JANET_TIMEZONE=America/New_York

# ---- Google Calendar (Phase G) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JANET_ENCRYPTION_KEY=             # random, 32+ characters; encrypts the stored Google token. Keep it.

# ---- Rep Site read-only data (Phase G) ----
REP_SITE_READ_ENABLED=false       # true only when DATABASE_URL is Rep Site's Supabase database

# ---- Optional tuning ----
OPENAI_REALTIME_MODEL=gpt-realtime
JANET_VOICE=marin                 # warm female voice; alternatives: shimmer, coral, sage
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
PORT=8080
